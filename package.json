{
  "name": "ubc-unified-data",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "UBC public institutional open-data mirror",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "update": "tsx src/update.ts",
    "collect:prose": "tsx src/collect-prose.ts",
    "validate:prose": "tsx src/validate-prose.ts",
    "validate:undergrad": "tsx src/validate-undergrad.ts",
    "test": "vitest run",
    "lint": "biome check src test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.2.0",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "fast-check": "4.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "markdown-it": "15.0.2",
    "robots-parser": "3.0.1",
    "sanitize-html": "2.17.7",
    "turndown": "7.2.4"
  }
}
